[Desktop Entry]
Type=Application
Name=Fyrn
Comment=Run GGUF models on this PC - no other program needed
# NOTE: the app dir and the home folder are baked in by install.sh
# (the same sed pass that fills in the Icon line below). Fyrn starts
# through the launcher in ~/.local/bin/fyrn, not run.sh directly:
# the launcher finds the folder again if it moved, so the icon keeps
# working after a move. Do NOT use the %k trick here: %k expands to
# the desktop file's own path, and the installed copy lives in
# ~/.local/share/applications — run.sh is not there, so the menu
# icon would silently do nothing (caught by the install sim).
Exec=__HOME__/.local/bin/fyrn
Icon=__APP_DIR__/assets/fyrn-48.png
Terminal=false
Categories=Utility;
StartupWMClass=fyrn
