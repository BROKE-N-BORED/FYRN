[Desktop Entry]
Type=Application
Name=Fyrn
Comment=Run GGUF models on this PC - no other program needed
# NOTE: the app dir is baked in by install.sh (the same sed pass that
# fills in the Icon line below). Do NOT use the %k trick here: %k expands to the
# desktop file's own path, and the installed copy lives in
# ~/.local/share/applications — run.sh is not there, so the menu
# icon would silently do nothing (caught by the install sim).
Exec=python3 -c "import subprocess; subprocess.call(['bash', '__APP_DIR__/run.sh'])"
Icon=__APP_DIR__/assets/fyrn-48.png
Terminal=false
Categories=Utility;
StartupWMClass=fyrn
